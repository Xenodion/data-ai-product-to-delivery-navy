# API + built front end. Build from the project root:
#   docker build -f flow/deploy/Dockerfile.api -t navy-api .
# The world database is built beforehand (python -m flow.world.build ...) and copied in; the image
# holds only synthetic data. Secrets are never copied: pass them as environment variables.

FROM node:22-slim AS front
WORKDIR /front
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.11-slim AS app
COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-default-groups --no-install-project
COPY flow ./flow
COPY ml/__init__.py ./ml/__init__.py
COPY ml/qualifier/__init__.py ./ml/qualifier/__init__.py
COPY ml/qualifier/src ./ml/qualifier/src
COPY .local/world/world.sqlite ./world/world.sqlite
COPY --from=front /front/dist ./static
RUN useradd --create-home navy && mkdir -p /app/.local/flow && chown -R navy /app/.local
USER navy
ENV PATH="/app/.venv/bin:$PATH" PYTHONPATH=/app \
    NAVY_WORLD_DB=/app/world/world.sqlite NAVY_STATIC_DIR=/app/static
EXPOSE 8080
CMD ["uvicorn", "flow.api:app", "--host", "0.0.0.0", "--port", "8080"]
